{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./storage/**)",
      "Read(../cadence-hackathon-main/cvs/**)",
      "Edit(../cadence-hackathon-main/**)"
    ],
    "allow": [
      "Bash(docker compose ps)",
      "Bash(docker compose logs:*)",
      "Bash(docker compose up:*)",
      "Bash(docker compose down)",
      "Bash(docker compose build:*)",
      "Bash(docker compose run --rm api pytest:*)",
      "Bash(docker compose run --rm api alembic:*)",
      "Bash(docker compose run --rm api ruff:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)"
    ]
  }
}