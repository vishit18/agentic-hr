# ============ Folders ============
# Isa's CV folder (mounted read-only into the app)
CVS_DIR=../cadence-hackathon-main/cvs
# Drop folder for new CVs; UI uploads land here too
INBOX_DIR=./storage/inbox
# How often the worker checks folders for new files (seconds)
POLL_SECONDS=15

# ============ Database ============
POSTGRES_USER=hub
POSTGRES_PASSWORD=change-me
POSTGRES_DB=hub
# Must use the same user/password as above
DATABASE_URL=postgresql+psycopg://hub:change-me@db:5432/hub

# ============ App ============
APP_SECRET_KEY=change-me-to-a-long-random-string
APP_ENV=local
MAX_UPLOAD_MB=15
MAX_PDF_PAGES=15

# ============ Local AI via Ollama (free) ============
OLLAMA_BASE_URL=http://host.docker.internal:11434
LLM_MODEL_EXTRACT=qwen2.5:7b
LLM_MODEL_RERANK=qwen2.5:14b
LLM_NUM_CTX=8192
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=2
WORKER_CONCURRENCY=4
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIM=768

# ============ Email (local catcher only) ============
SMTP_HOST=mailpit
SMTP_PORT=1025
MAIL_FROM=hub@cadence.local

# ============ Demo accounts (created by seed) ============
SEED_RECRUITER_EMAIL=recruiter@cadence.local
SEED_RECRUITER_PASSWORD=change-me
SEED_ADMIN_EMAIL=admin@cadence.local
SEED_ADMIN_PASSWORD=change-me
SEED_ENGINEER_EMAIL=engineer@cadence.local
SEED_ENGINEER_PASSWORD=change-me