# ============ Folders ============
# Isa's CV folder (mounted read-only into the app)
CVS_DIR=../cadence-hackathon-main/cvs
# Drop folder for new CVs; UI uploads land here too
INBOX_DIR=./storage/inbox
# How often the worker checks folders for new files (seconds)
POLL_SECONDS=15
# Let the laptop cool down: after every INGEST_BATCH_SIZE CVs, the worker pauses CV work for
# INGEST_BATCH_PAUSE_SECONDS. Set INGEST_BATCH_SIZE=0 to turn the pause off.
INGEST_BATCH_SIZE=50
INGEST_BATCH_PAUSE_SECONDS=60

# ============ Database ============
POSTGRES_USER=hub
POSTGRES_PASSWORD=change-me
POSTGRES_DB=hub
# Must use the same user/password as above
DATABASE_URL=postgresql+psycopg://hub:change-me@db:5432/hub

# ============ App ============
APP_SECRET_KEY=change-me-to-a-long-random-string
APP_ENV=local
MAX_UPLOAD_MB=15
MAX_PDF_PAGES=15

# ============ Local AI via Ollama (free) ============
OLLAMA_BASE_URL=http://host.docker.internal:11434
LLM_MODEL_EXTRACT=qwen2.5:7b
LLM_MODEL_RERANK=qwen2.5:7b
LLM_NUM_CTX=4096
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=2
# Longest CV text sent to the model (characters). Must fit in LLM_NUM_CTX with the prompt and the answer.
LLM_MAX_CV_CHARS=7000
# Simultaneous model calls (the GPU runs them one after another anyway)
LLM_MAX_CONCURRENT=2
WORKER_CONCURRENCY=2
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIM=768

# ============ Email (local catcher only) ============
SMTP_HOST=mailpit
SMTP_PORT=1025
MAIL_FROM=hub@agentic-hr.local

# ============ Demo accounts (created by seed) ============
SEED_RECRUITER_EMAIL=recruiter@agentic-hr.local
SEED_RECRUITER_PASSWORD=change-me
SEED_ADMIN_EMAIL=admin@agentic-hr.local
SEED_ADMIN_PASSWORD=change-me
SEED_ENGINEER_EMAIL=engineer@agentic-hr.local
SEED_ENGINEER_PASSWORD=change-me